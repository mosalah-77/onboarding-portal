    {
      "name": "Accepted handoff",
      "kind": "card",
      "refersTo": "handoff",
      "description": "Pale green accepted-scope surface. This shortened preview keeps the version label, source fact and suggested-checklist qualification.",
      "html": "<section class=\"ds-handoff\"><div class=\"ds-handoff-heading\"><h2 class=\"ds-handoff-title\">Accepted handoff</h2><span class=\"ds-handoff-version\">Version 2</span></div><p class=\"ds-handoff-copy\">This is the version the owner approved. A requested date still needs a delivery agreement.</p><dl class=\"ds-facts\"><div class=\"ds-fact\" id=\"ds-accepted-pages\"><dt class=\"ds-fact-label\">Pages</dt><dd class=\"ds-fact-value\"><ul class=\"ds-fact-list\"><li>Home</li><li>Services</li><li>Contact</li></ul></dd></div></dl><h3 class=\"ds-checklist-title\">Suggested delivery checklist</h3><p class=\"ds-checklist-help\">Review these tasks before planning delivery.</p><ol class=\"ds-checklist\"><li class=\"ds-checklist-item\">Review responsive layouts and accessibility for the accepted pages. <a class=\"ds-source-link\" href=\"#ds-accepted-pages\">Source fact</a></li></ol><button class=\"ds-download\" type=\"button\">Download handoff</button></section>",
      "css": ".ds-handoff{background:var(--shell,#e7ece5);color:var(--ink,#202e29);border-radius:var(--radius,12px);padding:1.8rem;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;line-height:1.55}.ds-handoff-heading{display:flex;justify-content:space-between;align-items:center;gap:.75rem;flex-wrap:wrap}.ds-handoff-title{margin:0;font-family:var(--display,\"Newsreader\",Georgia,serif);font-size:1.8rem;font-weight:550;line-height:1.35}.ds-handoff-version{display:inline-block;padding:.23rem .55rem;border-radius:5px;font-size:.75rem;font-weight:650;line-height:1.5;white-space:nowrap;background:var(--success,#e4f1e8);color:var(--success-ink,#24543a)}.ds-handoff-copy{font-size:.9rem;margin:.6rem 0 0;max-width:72ch}.ds-facts{font-size:.9rem;line-height:1.5}.ds-fact{display:grid;grid-template-columns:125px minmax(0,1fr);gap:1rem;border-bottom:1px solid var(--line,#d3dad4);padding:.8rem 0}.ds-fact-label{color:var(--muted,#57645e);font-size:.8rem}.ds-fact-value{margin:0;white-space:pre-wrap;overflow-wrap:anywhere}.ds-fact-list{margin:0;padding-left:1.15rem}.ds-checklist-title{font-size:1rem;font-weight:650;line-height:1.4;margin:0}.ds-checklist-help{color:var(--muted,#57645e);font-size:.9rem;margin:.6rem 0 0}.ds-checklist{font-size:.9rem;padding-left:1.4rem}.ds-checklist-item{padding:.25rem 0}.ds-source-link{color:var(--green,#245442);font-size:.75rem;white-space:nowrap;margin-left:.4rem;text-underline-offset:.22em}.ds-source-link:hover{text-decoration-thickness:2px}.ds-download{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:1rem;min-height:44px;padding:.6rem .9rem;border:1px solid #9aa99f;border-radius:7px;font-weight:600;line-height:1.35;cursor:pointer;background:var(--surface,#fff);color:var(--ink,#202e29)}.ds-download:hover:enabled{background:#edf2ec;border-color:var(--green,#245442)}.ds-download:active:enabled{background:#e1e9df}.ds-download:disabled{cursor:not-allowed;opacity:.58}.ds-download:focus-visible,.ds-source-link:focus-visible{outline:3px solid var(--focus,#2467bd);outline-offset:3px}@media(max-width:650px){.ds-handoff{padding:1.2rem}.ds-fact{grid-template-columns:1fr;gap:.25rem}}"
    },
    {
      "name": "Brief workflow",
      "kind": "custom",
      "refersTo": "workflow-steps",
      "description": "The actual three-stage workflow uses serif numbers, a current-stage rule and persistent stage names at narrow widths.",
      "html": "<ol class=\"ds-workflow\" aria-label=\"Brief workflow\"><li class=\"ds-workflow-item ds-current\" aria-current=\"step\"><span class=\"ds-step-number\" aria-hidden=\"true\">01</span><span><strong class=\"ds-step-title\">Brief</strong><small class=\"ds-step-copy\">Gather the facts</small></span></li><li class=\"ds-workflow-item\"><span class=\"ds-step-number\" aria-hidden=\"true\">02</span><span><strong class=\"ds-step-title\">Review</strong><small class=\"ds-step-copy\">Agree one version</small></span></li><li class=\"ds-workflow-item\"><span class=\"ds-step-number\" aria-hidden=\"true\">03</span><span><strong class=\"ds-step-title\">Handoff</strong><small class=\"ds-step-copy\">Start with clear scope</small></span></li></ol>",
      "css": ".ds-workflow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));list-style:none;padding:0;margin:0 0 2rem;gap:1.5rem;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;line-height:1.55}.ds-workflow-item{display:flex;align-items:center;gap:.8rem;padding:.25rem 0 1rem;margin:0;border-bottom:1px solid var(--line,#d3dad4);color:var(--muted,#57645e)}.ds-workflow-item.ds-current{color:var(--green-dark,#173c2e);border-bottom-color:var(--green-dark,#173c2e)}.ds-workflow-item.ds-complete{color:var(--green,#245442)}.ds-step-number{font-family:var(--display,\"Newsreader\",Georgia,serif);font-size:2.5rem;font-weight:400;line-height:1;font-variant-numeric:lining-nums tabular-nums}.ds-step-title{display:block;font-size:.9rem;font-weight:650}.ds-step-copy{display:block;font-size:.75rem;margin-top:.2rem}@media(max-width:650px){.ds-workflow{gap:.75rem;margin-bottom:1.5rem}.ds-workflow-item{display:block;padding-bottom:.7rem}.ds-step-number{display:block;font-size:1.8rem;margin-bottom:.25rem}.ds-step-copy{display:none}}"
    }
  ],
  "narrative": {
    "northStar": "The working brief",
    "overview": "Warm cream pages and a dark green navigation rail frame a practical workspace. White fields give longer answers room to breathe. Newsreader adds an editorial voice to the project name, readiness and accepted handoff; system sans carries labels, requests and activity. Fine rules and restrained state fills keep the screen easy to scan.\n\nThe same palette and type pairing carry into the reading guide. Its narrower measure and plain diagrams suit longer explanations. This AI-authored reference records the implemented system in `app/globals.css` and the portal components, with the approved direction in `docs/surface.md`. The sidecar's generated tonal strips are preview aids; the frontmatter holds the shipped color values.",
    "keyCharacteristics": [
      "Cream ground, dark green framing and white editing surfaces.",
      "Editorial headings paired with compact, sentence-case controls.",
      "Readiness, versions and accepted facts remain visibly distinct.",
      "Flat surfaces with borders; one elevated confirmation dialog."
    ],
    "rules": [
      {
        "name": "The Named State Rule",
        "body": "A colored status always names the state. A blocker names the missing input and links to its field.",
        "section": "colors"
      },
      {
        "name": "The Editorial Heading Rule",
        "body": "Use Newsreader for identity, the principal heading and the named workflow summaries. Keep editable content and ordinary section labels in system sans.",
        "section": "typography"
      },
      {
        "name": "The Dialog Depth Rule",
        "body": "Reserve elevation for the confirmation dialog. Keep the editor, readiness and handoff surfaces flat.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep the warm ground, white editor and dark green navigation together.",
      "Do preserve Newsreader headings and the system sans used by fields and longer requests.",
      "Do pair state colors with written labels, linked blockers and visible version numbers.",
      "Do keep readiness before the editor in the source order used by stacked layouts.",
      "Do retain visible keyboard focus, linked field errors and the existing control sizes.",
      "Do keep synthetic-data labels and AI authorship disclosures visible where they appear."
    ],
    "donts": [
      "Don't apply the dark rail's background color to the long-form editing surface.",
      "Don't replace state explanations with color alone.",
      "Don't turn the suggested checklist or requested deadline into a delivery promise.",
      "Don't add shadows to the flat work panels.",
      "Don't hide workflow stage names when their smaller captions are removed."
    ]
  }
}
