    {
      "name": "Field with linked blocker",
      "kind": "input",
      "refersTo": "input",
      "description": "The audience textarea pairs an invalid border with linked help and a written correction.",
      "html": "<div class=\"ds-field\"><label class=\"ds-field-label\" for=\"ds-audience\">Intended audience <span class=\"ds-field-note\">Required to submit</span></label><textarea class=\"ds-field-input\" id=\"ds-audience\" rows=\"3\" maxlength=\"2000\" aria-invalid=\"true\" aria-describedby=\"ds-audience-help ds-audience-error\"></textarea><p class=\"ds-field-error\" id=\"ds-audience-error\">Add the audience before submitting.</p><p class=\"ds-field-help\" id=\"ds-audience-help\">Describe who will use the website and what they need.</p></div>",
      "css": ".ds-field{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;color:var(--ink,#202e29);font-size:1rem;line-height:1.55}.ds-field-label{display:block;font-size:.9rem;font-weight:600;margin:1.1rem 0 .4rem}.ds-field-note{font-size:.78rem;font-weight:400;color:var(--muted,#57645e);margin-left:.4rem}.ds-field-input{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:1rem;width:100%;min-height:4rem;resize:vertical;line-height:1.5;border:1px solid #94a398;border-radius:6px;background:var(--surface,#fff);color:var(--ink,#202e29);padding:.6rem .7rem;caret-color:var(--green,#245442)}.ds-field-input[aria-invalid=true]{border-color:var(--error,#9a3028)}.ds-field-input:focus-visible{outline:3px solid var(--focus,#2467bd);outline-offset:3px}.ds-field-input:disabled{background:#eef0eb;color:var(--muted,#57645e);opacity:1}.ds-field-error{color:var(--error,#9a3028);font-size:.825rem;margin:.4rem 0}.ds-field-help{color:var(--muted,#57645e);font-size:.825rem;margin:.4rem 0 1rem}@media(max-width:650px){.ds-field-note{display:block;margin:.2rem 0 0}}"
    },
    {
      "name": "Project navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Dark green navigation uses a white selected project and light focus outlines. Section links wrap on mobile.",
      "html": "<aside class=\"ds-rail\"><nav class=\"ds-project-nav\" aria-label=\"Projects\"><button class=\"ds-project ds-selected\" type=\"button\" aria-current=\"page\">Client A · Website brief<small class=\"ds-project-note\">Draft · 1 required request</small></button><button class=\"ds-project\" type=\"button\">Client B · Website brief<small class=\"ds-project-note\">Draft · 1 required request</small></button></nav><nav class=\"ds-section-nav\" aria-label=\"In this project\"><a class=\"ds-section-link\" href=\"#brief-title\">Brief</a><a class=\"ds-section-link\" href=\"#requests\">Requests</a><a class=\"ds-section-link\" href=\"#handoff\">Accepted handoff</a><a class=\"ds-section-link\" href=\"#history\">Version history</a></nav></aside>",
      "css": ".ds-rail{background:var(--green-dark,#173c2e);color:var(--ground,#f4f2ed);padding:1.8rem 1.25rem;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;line-height:1.55}.ds-project-nav{display:grid;gap:.5rem}.ds-project{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;text-align:left;background:transparent;border:1px solid transparent;border-radius:7px;color:var(--ground,#f4f2ed);font-size:.85rem;font-weight:550;line-height:1.35;padding:.7rem;min-height:44px;cursor:pointer}.ds-project.ds-selected{background:var(--surface,#fff);border-color:var(--surface,#fff);color:var(--green-dark,#173c2e)}.ds-project:hover:enabled{background:#edf2ec;border-color:var(--green,#245442);color:var(--green-dark,#173c2e)}.ds-project:active:enabled{background:#e1e9df}.ds-project:disabled{cursor:not-allowed;opacity:.58}.ds-project-note{display:block;font-size:.73rem;font-weight:400;margin-top:.3rem}.ds-section-nav{display:grid;gap:.1rem;margin-top:1.6rem}.ds-section-link{color:#d4e4d6;font-size:.85rem;padding:.45rem .7rem;text-decoration:none}.ds-section-link:hover{background:var(--green,#245442);color:var(--surface,#fff);border-radius:5px}.ds-project:focus-visible,.ds-section-link:focus-visible{outline:3px solid var(--ground,#f4f2ed);outline-offset:3px}@media(max-width:650px){.ds-rail{padding:1rem}.ds-project-nav{grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin-top:.8rem}.ds-section-nav{display:flex;flex-wrap:wrap;gap:0;margin-top:.8rem}.ds-section-link{padding:.3rem .5rem;font-size:.78rem}}"
