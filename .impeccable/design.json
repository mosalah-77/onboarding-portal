    {
      "name": "Brief editor surface",
      "kind": "card",
      "refersTo": "editor",
      "description": "White editing surface with a ruled heading and saved-version context; padding reduces with available width.",
      "html": "<section class=\"ds-editor\"><div class=\"ds-editor-heading\"><h2 class=\"ds-editor-title\">Website brief</h2><span class=\"ds-editor-version\">Saved version 1</span></div><p class=\"ds-editor-copy\">Save an incomplete draft at any time. Complete the required inputs before submitting.</p></section>",
      "css": ".ds-editor{background:var(--surface,#fff);color:var(--ink,#202e29);border:1px solid var(--line,#d3dad4);border-radius:var(--radius,12px);padding:2rem;font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;line-height:1.55}.ds-editor-heading{display:flex;justify-content:space-between;align-items:center;gap:.75rem;flex-wrap:wrap;padding-bottom:1rem;border-bottom:1px solid var(--line,#d3dad4)}.ds-editor-title{margin:0;font-size:1.2rem;line-height:1.35;font-weight:650}.ds-editor-version{font-size:.8rem;color:var(--muted,#57645e)}.ds-editor-copy{font-size:.9rem;color:var(--muted,#57645e);margin:.6rem 0 1.6rem;max-width:72ch}@media(max-width:1200px){.ds-editor{padding:1.2rem}}@media(max-width:650px){.ds-editor{padding:1.1rem}}"
    },
    {
      "name": "Readiness summary",
      "kind": "card",
      "refersTo": "readiness",
      "description": "The saved-version summary names the missing input and links to its field. A ready modifier changes the fill and heading color.",
      "html": "<section class=\"ds-readiness\"><h2 class=\"ds-readiness-title\">Inputs needed</h2><p class=\"ds-readiness-copy\">Based on saved version 1.</p><ul class=\"ds-readiness-list\"><li><a class=\"ds-readiness-link\" href=\"#audience\">Add the audience before submitting.</a></li></ul><button class=\"ds-readiness-action\" type=\"button\" disabled>Submit version 1</button></section>",
      "css": ".ds-readiness{padding:1.3rem;border-radius:var(--radius,12px);border:1px solid #dac9a7;background:var(--warning,#fbefd6);color:var(--ink,#202e29);font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:.85rem;line-height:1.55}.ds-readiness-title{margin:0;font-family:var(--display,\"Newsreader\",Georgia,serif);font-size:1.9rem;font-weight:550;line-height:1.1;color:var(--warning-ink,#754b13)}.ds-readiness.ds-ready{background:var(--success,#e4f1e8);border-color:#b9d2bf}.ds-ready .ds-readiness-title{color:var(--success-ink,#24543a)}.ds-readiness-copy{margin:.6rem 0 0}.ds-readiness-list{padding-left:1.4rem}.ds-readiness-link{color:inherit;text-underline-offset:.22em}.ds-readiness-link:hover{text-decoration-thickness:2px}.ds-readiness-action{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:.85rem;font-weight:600;line-height:1.35;min-height:44px;padding:.6rem .9rem;border:1px solid var(--green,#245442);border-radius:7px;cursor:pointer;background:var(--green,#245442);color:var(--surface,#fff);width:100%;margin-top:.8rem}.ds-readiness-action:hover:enabled,.ds-readiness-action:active:enabled{background:var(--green-dark,#173c2e)}.ds-readiness-action:disabled{cursor:not-allowed;opacity:.58}.ds-readiness-action:focus-visible,.ds-readiness-link:focus-visible{outline:3px solid var(--focus,#2467bd);outline-offset:3px}@media(max-width:1000px){.ds-readiness-action{width:auto}}"
