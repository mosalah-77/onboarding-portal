      "html": "<button class=\"ds-button-primary\" type=\"button\">Save draft</button>",
      "css": ".ds-button-primary{font-family:ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif;font-size:1rem;font-weight:600;line-height:1.35;min-height:44px;padding:.6rem .9rem;border:1px solid #9aa99f;border-radius:7px;cursor:pointer;background:var(--surface,#fff);color:var(--ink,#202e29)}.ds-button-primary:hover:enabled{background:#edf2ec;border-color:var(--green,#245442)}.ds-button-primary:active:enabled{background:#e1e9df}.ds-button-primary{background:var(--green,#245442);color:var(--surface,#fff);border-color:var(--green,#245442)}.ds-button-primary:hover:enabled,.ds-button-primary:active:enabled{background:var(--green-dark,#173c2e);color:var(--surface,#fff)}.ds-button-primary:focus-visible{outline:3px solid var(--focus,#2467bd);outline-offset:3px}.ds-button-primary:disabled{cursor:not-allowed;opacity:.58}"
