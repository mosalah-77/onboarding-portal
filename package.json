{
  "name": "samepage",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "predeploy": "npm run build",
    "deploy": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js deploy --config dist/server/wrangler.json",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "test:unit": "node --experimental-strip-types --test tests/brief.test.mjs tests/assets.test.mjs tests/approval.test.mjs tests/client.test.mjs tests/cleanup.test.mjs tests/conversation.test.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test": "npm run test:unit && npm run test:api",
    "typecheck": "tsc --noEmit",
    "graph": "node scripts/refresh-graph.mjs",
    "prepare": "husky"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.70.1",
    "@cloudflare/workers-types": "5.20261123.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.39",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "husky": "9.1.7",
    "lint-staged": "17.6.2",
    "react-server-dom-webpack": "19.3.1",
    "typescript": "5.9.3",
    "vinext": "1.4.6",
    "vite": "8.3.8",
    "wrangler": "4.167.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.5"
    }
  }
}
